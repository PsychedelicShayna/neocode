{
  "cli": {
    "version": ">= 18.4.0",
    "appVersionSource": "local",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "corepack": true,
      "env": {
        "APP_VARIANT": "development",
        "NODE_OPTIONS": "--max-old-space-size=4096"
      },
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true,
        "image": "macos-tahoe-26.6-xcode-27.1"
      }
    },
    "preview": {
      "corepack": true,
      "env": {
        "APP_VARIANT": "preview",
        "NODE_OPTIONS": "--max-old-space-size=4096"
      },
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1"
      }
    },
    "preview:dev": {
      "extends": "preview",
      "developmentClient": true
    },
    "testflight": {
      "extends": "production",
      "distribution": "store",
      "env": {
        "T3CODE_MOBILE_VERSION": "3.0.0"
      }
    },
    "production": {
      "corepack": true,
      "env": {
        "APP_VARIANT": "production",
        "NODE_OPTIONS": "--max-old-space-size=4096",
        "SOURCEMAP_FILE": "/tmp/t3code-ios-main.jsbundle.map"
      },
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1"
      }
    }
  }
}
